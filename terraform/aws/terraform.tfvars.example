# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — never commit it with real account-specific values.

region                       = "us-east-1"
primary_availability_zone   = "us-east-1a"
secondary_availability_zone = "us-east-1b"

cluster_name    = "4thealth"
cluster_version = "1.31"

vpc_cidr            = "10.42.0.0/16"
node_instance_type  = "t3.medium"

# IAM users/roles (besides whoever runs `terraform apply`) who should get EKS cluster-admin:
admin_principal_arns = [
  # "arn:aws:iam::123456789012:user/alice",
]
